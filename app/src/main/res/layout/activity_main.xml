<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#10141C">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Python Runner"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initializing Python..."
        android:textColor="#A0AAB8"
        android:textSize="12sp"
        android:paddingTop="5dp"
        android:paddingBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#171E29">

        <TextView
            android:id="@+id/lineNumbers"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:background="#202936"
            android:gravity="top|end"
            android:paddingTop="14dp"
            android:paddingEnd="8dp"
            android:text="1"
            android:textColor="#718096"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"/>

        <EditText
            android:id="@+id/codeEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:padding="14dp"
            android:textColor="#E2E8F0"
            android:textColorHint="#718096"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:inputType="textMultiLine|textNoSuggestions"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:hint="Write Python code here..."/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/runButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="RUN"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#15803D"/>

        <Button
            android:id="@+id/clearButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="CLEAR"
            android:textColor="#FFFFFF"
            android:backgroundTint="#374151"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:orientation="vertical"
        android:background="#171E29"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONSOLE OUTPUT"
            android:textColor="#A5B4FC"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingBottom="8dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/outputConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Python console ready."
                android:textColor="#86EFAC"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"/>

        </ScrollView>

    </LinearLayout>

</LinearLayout>

